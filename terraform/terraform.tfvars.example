# Copy this file to terraform.tfvars and fill in your values

ssh_public_key     = "ssh-ed25519 AAAA... your-email@example.com"
nirvana_project_id = "your-nirvana-project-id"

# Optional: override defaults
# aws_region     = "us-west-1"
# nirvana_region = "us-sva-2"

# =============================================================================
# Instance & Storage Configuration (adjust for different benchmark scenarios)
# =============================================================================

# AWS Configuration
# aws_instance_type      = "m5.xlarge"    # Options: t3.large, m5.xlarge, m5.2xlarge, etc.
# aws_storage_size       = 256            # GB
# aws_storage_type       = "gp3"          # Options: gp3, gp2, io1, io2
# aws_storage_iops       = 3000           # IOPS (for gp3/io1/io2)
# aws_storage_throughput = 125            # MB/s (for gp3 only)

# Nirvana Configuration
# nirvana_instance_type  = "n1-standard-4"  # Options: n1-standard-2, n1-standard-4, n1-standard-8
# nirvana_storage_size   = 256              # GB
# nirvana_storage_type   = "abs"            # Nirvana ABS storage
