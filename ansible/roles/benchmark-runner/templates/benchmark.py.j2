#!/usr/bin/env python3
"""
LangChain-style benchmark: 100 agents × 10 tasks
Measures: IOPS, latency (p50/p95/p99), task time
"""

import json
import time
import statistics
import sys
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor
import numpy as np
import psycopg2
import redis
from qdrant_client import QdrantClient
from qdrant_client.models import VectorParams, Distance, PointStruct
from sentence_transformers import SentenceTransformer

PLATFORM = "{{ platform_name }}"
NUM_AGENTS = 100
TASKS_PER_AGENT = 10
EMBEDDING_DIM = 384


class BenchmarkRunner:
    def __init__(self):
        self.embedder = SentenceTransformer('all-MiniLM-L6-v2')
        self.latencies = []
        self.task_times = []

    def setup(self):
        conn = psycopg2.connect(host="localhost", database="benchmark", user="benchmark", password="benchmark")
        cur = conn.cursor()
        cur.execute("""CREATE TABLE IF NOT EXISTS checkpoints (
            id SERIAL PRIMARY KEY, agent_id TEXT, task_id TEXT, state JSONB, created_at TIMESTAMP DEFAULT NOW())""")
        conn.commit()
        cur.close()
        conn.close()

        client = QdrantClient(host="localhost", port=6333)
        try:
            client.delete_collection("documents")
        except:
            pass
        client.create_collection("documents", vectors_config=VectorParams(size=EMBEDDING_DIM, distance=Distance.COSINE))

    def run_agent_task(self, agent_id: int, task_id: int) -> float:
        task_start = time.time()
        qdrant = QdrantClient(host="localhost", port=6333)
        redis_client = redis.Redis(host="localhost", port=6379, db=0)
        pg_conn = psycopg2.connect(host="localhost", database="benchmark", user="benchmark", password="benchmark")
        pg_cur = pg_conn.cursor()

        try:
            # Vector writes
            docs = [f"Document {i} for agent {agent_id} task {task_id}" for i in range(10)]
            embeddings = self.embedder.encode(docs)
            for i, (doc, emb) in enumerate(zip(docs, embeddings)):
                start = time.time()
                qdrant.upsert("documents", [PointStruct(id=agent_id*10000+task_id*100+i, vector=emb.tolist(), payload={"text": doc})])
                self.latencies.append((time.time() - start) * 1000)

            # Vector reads
            queries = [f"Query {i} from agent {agent_id}" for i in range(5)]
            for qemb in self.embedder.encode(queries):
                start = time.time()
                qdrant.query_points("documents", query=qemb.tolist(), limit=5)
                self.latencies.append((time.time() - start) * 1000)

            # Redis write
            start = time.time()
            redis_client.setex(f"agent:{agent_id}:task:{task_id}", 3600, json.dumps({"status": "done"}))
            self.latencies.append((time.time() - start) * 1000)

            # Postgres write
            start = time.time()
            pg_cur.execute("INSERT INTO checkpoints (agent_id, task_id, state) VALUES (%s, %s, %s)",
                          (str(agent_id), str(task_id), json.dumps({"step": task_id})))
            pg_conn.commit()
            self.latencies.append((time.time() - start) * 1000)
        finally:
            pg_cur.close()
            pg_conn.close()

        self.task_times.append((time.time() - task_start) * 1000)

    def run_benchmark(self):
        self.setup()

        # Warmup
        print("Warmup...", file=sys.stderr, flush=True)
        with ThreadPoolExecutor(max_workers=10) as ex:
            list(ex.map(lambda x: self.run_agent_task(x[0], x[1]), [(a, t) for a in range(10) for t in range(2)]))
        self.latencies.clear()
        self.task_times.clear()

        # Benchmark
        print("Running benchmark...", file=sys.stderr, flush=True)
        start = time.time()
        with ThreadPoolExecutor(max_workers=NUM_AGENTS) as ex:
            list(ex.map(lambda x: self.run_agent_task(x[0], x[1]), [(a, t) for a in range(NUM_AGENTS) for t in range(TASKS_PER_AGENT)]))
        elapsed = time.time() - start

        return {
            "platform": PLATFORM,
            "timestamp": datetime.now().isoformat(),
            "iops": round(len(self.latencies) / elapsed, 2),
            "latency_p50_ms": round(np.percentile(self.latencies, 50), 2),
            "latency_p95_ms": round(np.percentile(self.latencies, 95), 2),
            "latency_p99_ms": round(np.percentile(self.latencies, 99), 2),
            "task_time_p50_ms": round(np.percentile(self.task_times, 50), 2),
            "task_time_p95_ms": round(np.percentile(self.task_times, 95), 2),
            "task_time_p99_ms": round(np.percentile(self.task_times, 99), 2),
        }


if __name__ == "__main__":
    print(json.dumps(BenchmarkRunner().run_benchmark(), indent=2))
