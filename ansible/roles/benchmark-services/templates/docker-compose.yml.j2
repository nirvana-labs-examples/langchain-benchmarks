version: '3.8'

services:
  postgres:
    image: postgres:15
    # Pin the durability contract: every COMMIT waits on WAL fsync
    command: postgres -c synchronous_commit=on
    environment:
      POSTGRES_USER: benchmark
      POSTGRES_PASSWORD: benchmark
      POSTGRES_DB: benchmark
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    restart: unless-stopped

  qdrant:
    image: qdrant/qdrant:latest
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - qdrant_data:/qdrant/storage
    restart: unless-stopped

  redis:
    image: redis:7
    # AOF on so Redis writes touch the disk; fsync policy is the experiment knob
    command: redis-server --appendonly yes --appendfsync {{ redis_appendfsync }}
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    restart: unless-stopped

volumes:
  postgres_data:
  qdrant_data:
  redis_data:
